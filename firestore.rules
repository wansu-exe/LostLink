rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    // True when the request comes from a signed-in user
    function isSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in user is the owner of the document
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when the signed-in user has the 'admin' role
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── /users/{uid} ──────────────────────────────────────────────────────────
    match /users/{uid} {
      // Any signed-in user can read their own document
      allow read: if isOwner(uid) || isAdmin();
      // Only the user can create their own document (done at registration)
      allow create: if isOwner(uid);
      // Only admin can update roles; owner can update other fields
      allow update: if isOwner(uid) || isAdmin();
    }

    // ── /items/{itemId} ───────────────────────────────────────────────────────
    match /items/{itemId} {
      // Anyone signed in can browse items (Home Feed, Search)
      allow read: if isSignedIn();

      // Only signed-in users can create a report
      allow create: if isSignedIn()
        && request.resource.data.reportedByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.status in ['lost', 'found'];

      // Owner can edit their own item; admin can update claimStatus
      allow update: if isOwner(resource.data.reportedByUid) || isAdmin();

      // Only admin can delete items
      allow delete: if isAdmin();
    }

    // ── /claims/{claimId} ─────────────────────────────────────────────────────
    match /claims/{claimId} {
      // Claimant can read their own claim; admin can read all
      allow read: if isOwner(resource.data.claimedByUid) || isAdmin();

      // Signed-in user can submit a claim for themselves
      allow create: if isSignedIn()
        && request.resource.data.claimedByUid == request.auth.uid;

      // Only admin can approve / reject
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }
  }
}
