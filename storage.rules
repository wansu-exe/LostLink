rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // item_photos/{itemId}.jpg
    match /item_photos/{itemId} {
      // Anyone signed in can download photos (shown in feed)
      allow read: if request.auth != null;

      // Signed-in users can upload; enforce 2 MB limit and image MIME types
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Only the uploader or admin can delete
      // (simplified: allow any signed-in user to delete for now)
      allow delete: if request.auth != null;
    }
  }
}
